# SEC-010: production base images pinned by digest. Refresh via
# scripts/refresh_image_digests.sh after a Renovate/Dependabot bump.
# node:26-slim @ 2026-05-01
FROM node:26-slim@sha256:36793bcbb160a6a16cede1e62b93f84e26b78a972a8a4c0b879c1c12f22761ec AS builder
WORKDIR /app/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
ARG CACHE_BUST=1
COPY ui/ .
COPY pyproject.toml README.md ../
COPY core/billing/limits.py ../core/billing/limits.py
COPY core/billing/catalog.py ../core/billing/catalog.py
COPY core/agents/ ../core/agents/
COPY core/governance/model_gateway.py ../core/governance/model_gateway.py
COPY core/governance/guardrails/ ../core/governance/guardrails/
COPY core/spend/pricing.py core/spend/reconcile.py core/spend/gate.py core/spend/access.py ../core/spend/
COPY connectors/ ../connectors/
COPY api/v1/model_gateway.py ../api/v1/model_gateway.py
COPY api/v1/guardrails.py ../api/v1/guardrails.py
COPY api/v1/observability.py ../api/v1/observability.py
COPY api/v1/spend.py ../api/v1/spend.py
COPY api/v1/conversation.py api/v1/conversation_supervisor.py api/v1/approvals.py ../api/v1/
COPY core/conversation/intents.py ../core/conversation/intents.py
COPY api/v1/customer_agent.py ../api/v1/customer_agent.py
COPY core/customer_agent/ ../core/customer_agent/
COPY api/v1/channels.py api/v1/voice_runtime.py ../api/v1/
COPY core/channels/ ../core/channels/
COPY observability/workload.py observability/timeline.py ../observability/
COPY docs/ ../docs/
COPY SECURITY.md docker-compose.yml ../
# Sources of the licensing guide (docs/user-guide/index.json).
COPY LICENSE COMMERCIAL-LICENSE.md TRADEMARKS.md ../
COPY core/rbac.py ../core/rbac.py
COPY auth/run_grants.py auth/token_pool.py ../auth/
COPY core/config.py ../core/config.py
COPY core/security/egress.py ../core/security/egress.py
COPY sdk/README.md ../sdk/README.md
COPY sdk-ts/README.md ../sdk-ts/README.md
COPY mcp-server/README.md ../mcp-server/README.md
ARG VITE_GA4_ID=""
ENV VITE_GA4_ID=$VITE_GA4_ID
ARG VITE_NATIVE_CONNECTOR_PREFILL_ENABLED="false"
ENV VITE_NATIVE_CONNECTOR_PREFILL_ENABLED=$VITE_NATIVE_CONNECTOR_PREFILL_ENABLED
RUN npm run build

# nginx:alpine @ 2026-05-01
FROM nginx:alpine@sha256:892bb2152464f0c5d8972593a5f5afaf8054552580b699d95f8ff4af08c2d33d
# CVE-2026-93990: the base ships libexpat 2.8.4-r0 and no nginx:alpine digest
# carries the fix yet. Upgrade in place, and fail the build if the fixed
# package is unavailable. Drop this once the base digest carries 2.8.5-r0.
# CVE-2026-4775: libgd pulls in tiff; require its patched package too.
# CVE-2026-88806: require the fixed X11 client library pulled in by libgd.
# CVE-2026-111497: require the patched Brotli decoder runtime library.
# CVE-2026-92392: require the curl release with the HTTP/2 upload fix.
RUN apk add --no-cache --upgrade 'libexpat>=2.8.5-r0' 'pcre2>=10.49-r0' 'tiff>=4.7.2-r0' 'libx11>=1.8.14-r0' 'brotli-libs>=1.2.1-r0' 'curl>=8.23.0-r0' 'libcurl>=8.23.0-r0'
COPY --from=builder /app/ui/dist /usr/share/nginx/html
COPY ui/nginx.cloudrun.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_ENVSUBST_FILTER='^(API_BACKEND_HOST|PORT)$'
ENV PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q --spider http://127.0.0.1:${PORT}/health || exit 1
