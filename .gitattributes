# Policy files are hashed byte-for-byte into policy results and evidence
# packages, so their line endings must not depend on the checkout platform.
core/policy/examples/*.yaml text eol=lf
# Versioned agent prompts are pinned by digest into case records and evidence packages.
core/agents/*/prompts/*.txt text eol=lf
# Shell scripts run inside the Linux containers of docker-compose.dev.yml
# (scripts/run_e2e.sh in the Playwright image, for example). A CRLF checkout
# on Windows makes them unrunnable there, so their line endings must not
# depend on the checkout platform either.
*.sh text eol=lf
