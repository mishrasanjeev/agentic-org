{
  "name": "agenticorg-mcp-server",
  "version": "5.1.0",
  "mcpName": "io.github.mishrasanjeev/agenticorg",
  "description": "Repository MCP adapter for company-scoped AgenticOrg workflow candidates and read-only discovery",
  "author": {
    "name": "Sanjeev Kumar",
    "email": "sanjeev@orchestrum.in"
  },
  "maintainers": [
    {
      "name": "Orchestrum Technologies LLP",
      "email": "sanjeev@orchestrum.in"
    }
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agenticorg-mcp": "dist/index.js"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishrasanjeev/agentic-org.git"
