FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
WORKDIR /app/ui
COPY --from=agenticorg-channel-ui-tools:local /app/ui/node_modules ./node_modules
COPY --from=agenticorg-channel-ui-tools:local /app/ui/package.json /app/ui/playwright.config.ts ./
# Mount the test sources at runtime; production Docker context excludes E2E files.
CMD ["npx", "playwright", "test", "channel-workflows-local.spec.ts", "--retries=0", "--workers=1"]
