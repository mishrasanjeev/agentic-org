{
  "displayName": "AgenticOrg governance",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Authoritative decision dwell (issuer-measured, p50)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "histogram_quantile(0.5, sum by (le) (rate(agenticorg_case_decision_dwell_seconds_bucket{dwell_source=\"server\"}[1h])))"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Share of approvals submitted within 15s",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "sum(rate(agenticorg_case_decision_dwell_seconds_bucket{dwell_source=\"server\",le=\"15\"}[6h])) / sum(rate(agenticorg_case_decision_dwell_seconds_count{dwell_source=\"server\"}[6h]))"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Decisions recorded vs authoritative dwell samples",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "sum(rate(agenticorg_governed_case_transitions_total{to_state=\"decided\"}[1h]))"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Authoritative dwell samples arriving",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "sum(rate(agenticorg_case_decision_dwell_seconds_count{dwell_source=\"server\"}[1h])) or vector(0)"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Tool-call denials (deny mode)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "sum by (reason) (rate(agenticorg_grant_enforcement_denials_total{mode=\"deny\"}[10m]))"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Provider call failure share",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "sum(rate(agenticorg_provider_calls_total{outcome!=\"ok\"}[15m])) / sum(rate(agenticorg_provider_calls_total[15m]))"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Case push dead letters",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "sum by (reason) (rate(agenticorg_case_push_dead_letters_total[1h]))"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Unreplayed dead-letter backlog",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "max(agenticorg_case_push_dead_letter_backlog)"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 16,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Chain verification failures",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "sum by (chain) (increase(agenticorg_chain_verifications_total{outcome=\"failed\"}[1h]))"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 16,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Spend caps crossed",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "prometheusQuery": "sum by (outcome) (increase(agenticorg_budget_cap_events_total[2h]))"
              }
            ]
          }
        }
      }
    ]
  }
}
